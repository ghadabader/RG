# Copy this file to .env and fill in real values. .env is gitignored — never commit it.
# Used by the local "atlassian" MCP server (mcp-atlassian) declared in .mcp.json.

# Jira Cloud
JIRA_URL=https://your-domain.atlassian.net
JIRA_USERNAME=you@example.com
JIRA_API_TOKEN=

# Confluence Cloud
CONFLUENCE_URL=https://your-domain.atlassian.net/wiki
CONFLUENCE_USERNAME=you@example.com
CONFLUENCE_API_TOKEN=

# Optional: restrict which tools/projects/spaces the server exposes
# JIRA_PROJECTS_FILTER=PROJ1,PROJ2
# CONFLUENCE_SPACES_FILTER=SPACE1,SPACE2
# READ_ONLY=true

# GitHub (used by the "github" MCP server declared in .mcp.json)
# NOTE: this server uses Claude Code's ${VAR} expansion, which reads your real
# shell/OS environment — NOT this .env file. Set this as an actual environment
# variable too (see setup instructions), not just here.
GITHUB_PERSONAL_ACCESS_TOKEN=

# --- App (Spec 0001). Put these in .env.local, not .env (.env.local is gitignored). ---
NEXT_PUBLIC_SUPABASE_URL=
# The project's anon or publishable key (public by design).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Used to build the password-reset link.
SITE_URL=http://localhost:3000
# TEST CODE ONLY — never referenced by app code (enforced by tests/auth/unit/serviceRoleGuard.test.ts).
SUPABASE_SERVICE_ROLE_KEY=
# Postgres connection string, only for applying db/migrations/*.sql by hand.
SUPABASE_DB_URL=
